rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function identity(uid) {
      return uid == 'MQi5CK8RaGbgldD5FjEbRTbJsvE2' ? 'him' : 'her';
    }

    function authed() {
      return request.auth != null
        && request.auth.uid in ['MQi5CK8RaGbgldD5FjEbRTbJsvE2', 'gvc8NoVfbiVOyvPTgJd5SI6mn7b2'];
    }

    match /messages/{msgId} {
      allow read: if authed();
      allow create: if authed()
        && request.resource.data.from == identity(request.auth.uid);
      allow update: if authed();
    }

    match /status/{docId} {
      allow read: if authed();
      allow create: if authed()
        && request.resource.data.from == identity(request.auth.uid);
    }

    match /canvas_strokes/{strokeId} {
      allow read: if authed();
      allow create: if authed()
        && request.resource.data.from == identity(request.auth.uid);
      allow delete: if authed();
    }

    match /canvas_snapshots/{snapId} {
      allow read: if authed();
      allow create: if authed()
        && request.resource.data.from == identity(request.auth.uid);
      allow delete: if authed();
    }

    match /playback/{userId} {
      allow read: if authed();
      allow write: if false;
    }

    match /spotify-commands/{cmdId} {
      allow read: if authed();
      allow create: if authed();
      allow update, delete: if false;
    }
  }
}
